rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.email is string &&
             data.email.size() >= 3 &&
             data.email.size() <= 254 &&
             data.username is string &&
             data.username.size() >= 2 &&
             data.username.size() <= 40 &&
             data.fullName is string &&
             data.fullName.size() >= 1 &&
             data.fullName.size() <= 80 &&
             data.emailVerified is bool &&
             data.authProvider is string &&
             data.authProvider == 'google' &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 512)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId',
                         'email',
                         'username',
                         'fullName',
                         'emailVerified',
                         'authProvider',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId',
                         'email',
                         'username',
                         'fullName',
                         'emailVerified',
                         'authProvider',
                         'photoUrl',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().authProvider == existing().authProvider &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'email',
                         'username',
                         'fullName',
                         'emailVerified',
                         'photoUrl',
                         'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
